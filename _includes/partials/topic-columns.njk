{# Every post under each of its topics, heaviest topic first. #}
<div class="topics" id="view-topics">
  {%- for tag in collections.tagList | byCount(collections.posts) %}
  {%- set tagged = collections.posts | byTag(tag) %}
  <section class="topic" id="topic-{{ tag }}">
    <h2><a href="/tag/{{ tag }}/">{{ tag }}</a> <span>{{ tagged | length }}</span></h2>
    <ul>
      {%- for post in tagged %}
      <li><a href="{{ post.url }}">{{ post.data.title }}</a></li>
      {%- endfor %}
    </ul>
  </section>
  {%- endfor %}
</div>
