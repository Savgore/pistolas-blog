{# Expects `post`, one item from collections.posts. #}
{% set displayTagList = post.data.tags | displayTags %}
<article class="entry">
  <p class="m">
    <time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
    {%- if displayTagList.length %} ·
    {%- for tag in displayTagList %} <a href="/tag/{{ tag }}/" data-topic="{{ tag }}">{{ tag }}</a>{% if not loop.last %},{% endif %}{% endfor %}
    {%- endif %} · {{ post.templateContent | readingTime }} min read
  </p>
  <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
  {% if post.data.description %}<p class="s">{{ post.data.description }}</p>{% endif %}
</article>
