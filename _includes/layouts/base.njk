<!DOCTYPE html>
<html lang="en">
<head>
{% include "partials/head-meta.njk" %}
<link rel="icon" href="/favicon.ico" sizes="32x32">
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>

<canvas id="spark" aria-hidden="true"></canvas>

<div id="find" role="search">
  <label for="find-q">Search</label>
  <input id="find-q" type="search" autocomplete="off" spellcheck="false">
  <span class="count" id="find-count"></span>
</div>

{% include "partials/keys.njk" %}

<div class="frame">
  {% include "partials/masthead.njk" %}
  <main id="main">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
</div>

<script src="/assets/js/site.js" defer></script>
</body>
</html>
