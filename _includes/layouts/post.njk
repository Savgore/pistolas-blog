---
layout: base
---
{% set displayTagList = tags | displayTags %}
{% set firstTag = displayTagList[0] if displayTagList.length else null %}
{% set body = content | addHeadingIds %}
{% set sections = content | headings %}

<article class="post">
  <header class="post-hd">
    <h1>{{ title }}</h1>
    {% if description %}<p class="dek">{{ description }}</p>{% endif %}
    <p class="line">
      {%- if date %}<time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>{% endif %}
      {%- if displayTagList.length %} ·
      {%- for tag in displayTagList %} <a href="/tag/{{ tag }}/">{{ tag }}</a>{% if not loop.last %},{% endif %}{% endfor %}
      {%- endif %} · {{ content | readingTime }} min read
    </p>
  </header>

  <div class="prose">
    {{ body | safe }}
  </div>

  <aside class="aside">
    {% if sections.length %}
    <p class="hd">Contents</p>
    <ol>
      {%- for s in sections %}
      <li><a href="#{{ s.id }}">{{ s.text }}</a></li>
      {%- endfor %}
    </ol>
    {% endif %}
    {% if displayTagList.length %}
    <p class="hd">Filed under</p>
    <ul class="sn">
      {%- for tag in displayTagList %}
      <li><a href="/tag/{{ tag }}/">{{ tag }}</a></li>
      {%- endfor %}
    </ul>
    {% endif %}
  </aside>

  {% if firstTag %}
  {%- set related = collections.posts | byTag(firstTag) | without(page.url) | limit(6) %}
  {%- if related.length %}
  <div class="related">
    <p class="hd">More on {{ firstTag }}</p>
    <ul>
      {%- for post in related %}
      <li><a href="{{ post.url }}">{{ post.data.title }}</a></li>
      {%- endfor %}
    </ul>
  </div>
  {%- endif %}
  {% endif %}
</article>
