<div class="page-hd">
  <h1>Contact</h1>
  <p>Say hello - email <a href="mailto:savva@pistolas.co.uk">savva@pistolas.co.uk</a>, or fill out the below.</p>
</div>

<p class="sent" id="contact-sent" hidden tabindex="-1">Sent.</p>

<form class="contact" id="contact-form" action="https://formspree.io/f/xqpkzgyr" method="POST">
  <p class="field">
    <label for="contact-name">Name</label>
    <input id="contact-name" name="name" type="text" autocomplete="name" required>
    <span class="err" data-err="name"></span>
  </p>

  <p class="field">
    <label for="contact-email">Email</label>
    <input id="contact-email" name="email" type="email" autocomplete="email" required>
    <span class="err" data-err="email"></span>
  </p>

  <p class="field">
    <label for="contact-message">Message</label>
    <textarea id="contact-message" name="message" rows="9" required></textarea>
    <span class="err" data-err="message"></span>
  </p>

  {# Gives the mail a subject line in the inbox. #}
  <input type="hidden" name="_subject" value="pistolas.co.uk contact form">

  {# Honeypot. Off-screen rather than display:none, which some bots skip. #}
  <p class="gotcha" aria-hidden="true">
    <label for="contact-gotcha">Leave empty</label>
    <input id="contact-gotcha" type="text" name="_gotcha" tabindex="-1" autocomplete="off">
  </p>

  <p class="actions">
    <button type="submit">Send</button>
    <span class="status" role="status"></span>
  </p>
</form>
